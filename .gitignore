# ===== 构建产物 =====

# CMake / 顶层构建（SDK 静态库、Ubuntu 客户端、测试均在 build/ 下）
build/

# Ubuntu/Qt 其他常见构建目录
build-*/
*.user

# 编译中间产物（防御性）
*.o
*.obj
*.a
*.so
*.so.*

# ===== HarmonyOS / DevEco Studio =====

# hvigor 构建缓存
.hvigor/
harmonyos-client/.hvigor/

# 依赖模块（由 DevEco 通过 ohpm 拉取）
oh_modules/
harmonyos-client/oh_modules/

# 编译产物
harmonyos-client/entry/build/
harmonyos-client/entry/.cxx/
harmonyos-client/entry/.preview/

# 命令行构建的本地缓存 / SDK 路径 / 三方源码与交叉编译产物
harmonyos-client/.npm-cache/
harmonyos-client/.cache/
harmonyos-client/.pnpm-home/
harmonyos-client/local.properties
harmonyos-client/third_party/

# 本地 debug 签名材料（含私钥）与签名产物
harmonyos-client/sign/

# 但保留交叉编译进工程的 OpenSSL 静态库（构建必需，勿忽略）
!harmonyos-client/entry/src/main/cpp/openssl/lib/libcrypto.a
!harmonyos-client/entry/src/main/cpp/openssl/lib/libssl.a

# DevEco Studio（IntelliJ 系）工程级配置
.idea/

# ===== IDE / 系统 =====

# Trae IDE 私有目录（计划文档、规则缓存等本地状态）
.trae/

# macOS
.DS_Store

# ===== 日志 / 临时文件 =====

*.log
*.tmp
*.swp

# ===== 运行时数据（SDK 默认数据目录，双实例联调时也落在此处）=====
localsend-data/
